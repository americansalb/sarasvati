# SARASVATI Environment Configuration
# Copy this file to .env and fill in your values

# Groq API (for LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# LiveKit (for audio streaming)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (for ASR)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# System Configuration
MAX_BUFFER_SIZE=50
ALIGNMENT_WINDOW_SECONDS=30.0
ALIGNMENT_THRESHOLD=0.65
ENABLE_NEGATION_CHECK=true

# Models
GROQ_MODEL_VERIFICATION=llama-3.1-70b-versatile
GROQ_MODEL_DRAFTING=llama-3.1-8b-instant

# Monitoring
LOG_LEVEL=INFO
ENABLE_DEBUG=false
