# SARASVATI Frontend Configuration
# Copy this file to .env.local and configure

# LiveKit Configuration
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_API_KEY=your_api_key_here
NEXT_PUBLIC_LIVEKIT_API_SECRET=your_api_secret_here

# Backend WebSocket URL
NEXT_PUBLIC_BACKEND_WS_URL=http://localhost:3001

# Room Configuration
NEXT_PUBLIC_ROOM_NAME=sarasvati-session

# Optional: Debug Mode
NEXT_PUBLIC_DEBUG=false
